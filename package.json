{
  "name": "fire-trace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typegen": "next typegen",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "npx -y firebase-tools@latest emulators:exec --only auth,firestore --project demo-firetrace \"vitest run --project integration\"",
    "test:e2e": "playwright test",
    "emulators": "npx -y firebase-tools@latest emulators:start --only auth,firestore --project demo-firetrace",
    "seed:emulator": "tsx scripts/seed-emulator.ts",
    "trace:example": "tsx scripts/send-example-trace.ts",
    "firebase:deploy": "npx -y firebase-tools@latest deploy --only firestore,auth",
    "sdk:build": "pnpm --filter @firetrace/sdk build",
    "sdk:typecheck": "pnpm --filter @firetrace/sdk typecheck",
    "mcp:stdio": "tsx packages/mcp-server/src/cli.ts",
    "mcp:build": "pnpm --filter @firetrace/mcp build",
    "mcp:typecheck": "pnpm --filter @firetrace/mcp typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4",
    "@firetrace/mcp": "workspace:*"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@firetrace/sdk": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "jwks-rsa": "^3.2.2"
    }
  }
}
