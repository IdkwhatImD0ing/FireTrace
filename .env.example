# ---------------------------------------------------------------------------
# FireTrace environment. Copy to .env.local for development. On Vercel, add
# each value under Project Settings -> Environment Variables (Preview and
# Production get their own values; see docs/vercel-deployment.md).
# ---------------------------------------------------------------------------

# Public Firebase Web app configuration. These values are used by Firebase Auth
# in the browser only (sign-in). They are not secrets, but keep them out of git.
# Get them with: npx -y firebase-tools@latest apps:sdkconfig WEB <APP_ID> --project <PROJECT_ID>
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Admin SDK credentials. Store the complete service-account JSON as
# base64 (single line):  base64 -w0 service-account.json   (macOS: base64 -i ...)
# The raw JSON text is accepted too; base64 line breaks are ignored.
# Leave empty in development to fall back to Application Default Credentials
# (gcloud auth application-default login). Production fails closed without it.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Comma-separated trusted dashboard emails. Every listed address is a co-owner
# with access to every project. Production fails closed when this is empty.
DASHBOARD_ALLOWED_EMAILS=

# Random server-only secret used to HMAC project API keys (>= 32 chars).
# Generate with: openssl rand -base64 48
FIRETRACE_KEY_PEPPER=

# Canonical public deployment URL (no trailing slash). Used for Origin checks
# on cookie-authenticated requests and in copyable setup snippets.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage warning threshold in bytes. Defaults to the Firestore free tier
# (1 GiB) when unset; warnings appear at 70% and 90%.
# FIRETRACE_STORAGE_LIMIT_BYTES=1073741824

# Trial mode for a public demo instance. When set to a positive number, any
# verified account that is NOT in DASHBOARD_ALLOWED_EMAILS may sign in as a
# trial user: one project and this many traces in total, ever (deleting does
# not refill it), then a message pointing at deploying their own FireTrace.
# Leave unset (0) for a private deployment where only the allowlist signs in.
# FIRETRACE_TRIAL_TRACE_LIMIT=5

# Explicit development-only emulator configuration. When FIRETRACE_USE_EMULATORS
# is "true" the server talks to the local Auth + Firestore emulators and the
# allowlist may be empty. NEXT_PUBLIC_FIRETRACE_USE_EMULATORS makes the browser
# sign in against the Auth emulator. The host variables default to the values
# below and are ignored unless FIRETRACE_USE_EMULATORS is "true". Never enable
# these in production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIRETRACE_USE_EMULATORS=false
NEXT_PUBLIC_FIRETRACE_USE_EMULATORS=false

# Optional: public repository URL used by the landing page "View GitHub" and
# "Deploy your own" links. Defaults to a placeholder until the repo is public.
# NEXT_PUBLIC_REPOSITORY_URL=https://github.com/IdkwhatImD0ing/FireTrace
