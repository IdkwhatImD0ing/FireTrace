rules_version = '2';

// FireTrace: the browser never talks to Firestore directly. All reads and
// writes go through Next.js server code using the Firebase Admin SDK, which
// verifies the owner's session cookie or a project ingestion key first.
// Deny every direct client request, authenticated or not.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
